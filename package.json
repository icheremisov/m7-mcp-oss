{
  "name": "@m7/mcp-server",
  "version": "3.22.2",
  "description": "M7 MCP Server (secure fork) - methodology-enforcing MCP server; LLM calls via local opencode CLI, no API keys",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "m7-mcp": "./dist/index.js",
    "@m7/mcp-server": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "bash scripts/run-tests.sh",
    "test:mutants": "node scripts/deep-scan-mutants.mjs"
  },
  "keywords": [
    "mcp",
    "m7",
    "methodology",
    "orchestration",
    "memory",
    "patterns",
    "enforcement",
    "anti-chaos",
    "code-quality",
    "ai-assistant",
    "opencode"
  ],
  "author": "DukeDeSouth",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.5.3",
    "diff": "^7.0.0",
    "js-yaml": "^4.1.1",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^11.0.0",
    "p-queue": "^8.0.1",
    "semver": "^7.6.3",
    "ts-morph": "^27.0.2",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist/**/*",
    "src/tsi/patterns/**/*",
    "config/**/*",
    "templates/**/*",
    "workflows/**/*",
    "README.md",
    "LICENSE"
  ]
}
